---
interface Props {
	src: string;
	alt?: string;
	caption?: string;
}

const { src, alt = '', caption } = Astro.props;
---

<figure class="image-item">
	<img src={src} alt={alt} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.image-item {
		margin: 0;
	}

	.image-item img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 6px;
	}

	.image-item figcaption {
		margin-top: 0.35rem;
		font-size: 0.8em;
		font-style: italic;
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>

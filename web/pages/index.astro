                href: '/',
            },
            {
                icon: '📌',
                name: 'Sticky Message',
                description: 'Ghim tin nhắn cố định trong kênh theo style của bạn!',
                attachment: videos.stickie,
                is_video: true,
                href: '/',
            },

        ]
        const featureList = document.getElementById('featureList')
        featureList.innerHTML = ''
        featureData.map(item => {
            let attachmentElement = ``
            if(item.is_video === true){
                attachmentElement = `<video src="${item.attachment}" autoplay="" loop="" muted="" class="preview"></video>`
            } else {
                attachmentElement = `<img src="${item.attachment}" class="preview">`
            }
            featureList.innerHTML += 
            `
            <div class="card" onclick="window.open('${item.href}', '_blank');">
                ${attachmentElement}
                <div class="absolute">
                    <div class="content">
                        <h1 class="header">${item.name}</h1>
                        <p class="description">${item.description}</p>
                        <a class="learn">Tìm hiểu thêm <svg width="1em" height="1em" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224H32c-17.7 0-32 14.3-32 32s14.3 32 32 32h306.7L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg></a>
                    </div>
                </div>
                <div class="icon">${item.icon}</div>
            </div>
            `
        })
        updateAllCardHeights();

        function animateNumber(element, target, suffix, duration = 2500) {
            const start = target * 0.5;
            let startTime = null;
            let hasStarted = false;
            const isDecimal = target.toString().includes('.');
            const power = 4 + Math.random() * 2; 
            
            function easeOut(t) {
                return 1 - Math.pow(1 - t, power);
            }
            
            function update(currentTime) {
                if (!startTime) startTime = currentTime;
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easedProgress = easeOut(progress);
                const current = start + (target - start) * easedProgress;
                
                if (!hasStarted) {
                    hasStarted = true;
                }
                
                if (isDecimal) {
                    element.textContent = current.toFixed(1).replace('.', ',') + suffix;
                } else {
                    element.textContent = Math.floor(current).toLocaleString('en-US') + suffix;
                }
                
                if (progress < 1) {
                    requestAnimationFrame(update);
                }
            }
            
            requestAnimationFrame(update);
        }
        
        setTimeout(() => {
            const statsElements = document.querySelectorAll('.stats .text');
            const CACHE_KEY = 'stats';
            
            function updateStats(data) {
                const serverEl = statsElements[0];
                const userEl = statsElements[1];
                
                if (serverEl && data.total_servers) {
                    serverEl.setAttribute('data-target', data.total_servers);
                }
                if (userEl && data.total_users) {
                    userEl.setAttribute('data-target', data.total_users);
                }
            }
            
            function animateAllStats() {
                statsElements.forEach(el => {
                    const target = parseFloat(el.getAttribute('data-target'));
                    const suffix = el.getAttribute('data-suffix') || '';
                    animateNumber(el, target, suffix);
                });
            }
            
            // Load from cache first
            const cached = localStorage.getItem(CACHE_KEY);
            if (cached) {
                try {
                    const data = JSON.parse(cached);
                    updateStats(data);
                } catch (e) {}
            }
            
            // Animate with cached/default values immediately
            animateAllStats();
            
            // Fetch fresh data
            fetch('https://service.tudubucket.dev/dashboard/status')
                .then(res => res.json())
                .then(data => {
                    localStorage.setItem(CACHE_KEY, JSON.stringify(data));
                    updateStats(data);
                    animateAllStats();
                })
                .catch(() => {});
        }, 1);
    </script>

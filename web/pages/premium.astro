---
import '../styles/premium.css';
import Page from '../components/landing/Page.astro';
import { premiumEmbed } from '../data/embed.mjs';
import { BRAND } from '../data/brand.mjs';

const { name, links } = BRAND;
const UNLIMITED = -1;

type Row = { label: string; default: number; plus: number; extended: number };
type Group = { title: string; rows: Row[] };

// Lấy từ bảng giới hạn của bot (premium-plans.txt / limitation.py), -1 là không giới hạn
const groups: Group[] = [
    {
        title: 'Tự động hóa',
        rows: [
            { label: 'Autoresponder', default: 40, plus: 100, extended: 300 },
            { label: 'Embed', default: 15, plus: 40, extended: 100 },
            { label: 'Layout', default: 10, plus: 30, extended: 80 },
            { label: 'Button', default: 15, plus: 75, extended: 250 },
            { label: 'Select', default: 3, plus: 10, extended: 30 },
            { label: 'Lựa chọn mỗi select', default: 15, plus: 25, extended: 25 },
            { label: 'Form', default: 5, plus: 30, extended: 100 },
            { label: 'Lượt gửi form mỗi thành viên', default: 10, plus: 20, extended: 30 },
            { label: 'Sticky Message', default: 5, plus: 15, extended: 30 },
        ],
    },
    {
        title: 'Cộng đồng',
        rows: [
            { label: 'Custom Role', default: 50, plus: 300, extended: 1000 },
            { label: 'Giveaway đang chạy', default: 20, plus: 100, extended: 1000 },
            { label: 'Template giveaway', default: 10, plus: 30, extended: 100 },
            { label: 'Item', default: 5, plus: 30, extended: 100 },
        ],
    },
    {
        title: 'Ticket',
        rows: [
            { label: 'Panel ticket', default: 5, plus: 10, extended: 25 },
            { label: 'Role ưu tiên mỗi panel ticket', default: 2, plus: 10, extended: 20 },
            { label: 'Ticket mở cùng lúc mỗi thành viên', default: 10, plus: 20, extended: 30 },
        ],
    },
    {
        title: 'Ủng hộ',
        rows: [
            { label: 'Người nhận ủng hộ', default: 10, plus: 30, extended: 60 },
            { label: 'Role phần thưởng ủng hộ', default: 10, plus: 25, extended: 50 },
            { label: 'Kênh nhận ủng hộ', default: 10, plus: 25, extended: 50 },
        ],
    },
];
const extras = [
    ['Sticky Message gửi bằng webhook', 'Không', 'Có', 'Có'],
    ['Ảnh đại diện và banner bot tùy chỉnh', 'Không', 'Có', 'Có'],
    ['Thời hạn', 'Vĩnh viễn', 'Theo tháng/Lifetime', 'Theo tháng/Lifetime'],
];

const fmt = (n: number) => (n === UNLIMITED ? '∞' : n.toLocaleString('vi-VN'));
const money = (n: number) => `${n.toLocaleString('vi-VN')}đ`;

const plans = [
    {
        id: 'plus',
        name: 'Plus',
        tagline: 'Cho những server community ở mức vừa phải.',
        month: 36000,
        lifetime: 250000,
        featured: true,
        includes: 'Default',
        points: ['Giới hạn cao hơn (x3-x5)', 'Cho phép custom avatar bot, banner, style tên bot & bio bot', 'Trả theo tháng hoặc mua lifetime'],
    },
    {
        id: 'extended',
        name: 'Extended',
        tagline: 'Cho server lớn, muốn gần như không phải đếm.',
        month: 59000,
        lifetime: 500000,
        includes: 'Plus',
        points: ['Giới hạn cao nhất (x7-x20)', 'Dư dả cho server lớn, gần như không phải lăn tăn', 'Trả theo tháng hoặc mua lifetime'],
    },
    {
        id: 'enterprise',
        name: 'Enterprise',
        tagline: 'Đôi khi bạn cần những yêu cầu lớn hơn nữa.',
        includes: 'Extended',
        points: ['Giới hạn từng tính năng theo nhu cầu', 'Thời hạn tùy chỉnh', 'Giá theo nhu cầu của server'],
    },
];

const benefits = [
    { icon: '1f4c8', title: 'Giới hạn cao hơn', text: 'Autoresponder, Embed, Button, Form, Giveaway và nhiều tính năng khác được tạo nhiều hơn hẳn plan Default.' },
    { icon: '1f3a8', title: 'Bot mang diện mạo riêng', text: 'Plus và Extended cho phép đặt ảnh đại diện và banner bot riêng cho server.' },
    { icon: '1f5d3', title: 'Tháng hoặc lifetime', text: 'Trả theo tháng nếu cần linh hoạt, hoặc mua lifetime một lần để dùng lâu dài.' },
    { icon: '1f6df', title: 'Hết hạn vẫn an toàn', text: 'Những gì bạn đã tạo vẫn được giữ lại. Chỉ là chưa tạo thêm được cho tới khi gia hạn hoặc xóa bớt.' },
];

const faqs = [
    {
        q: 'Plan áp dụng cho server nào?',
        a: 'Mỗi plan gắn với đúng một server, là server bạn chọn lúc mua. Các server khác vẫn dùng plan của riêng nó. Nếu bạn có nhiều server cần nâng cấp, mỗi server sẽ là một plan riêng.',
    },
    {
        q: 'Mình có chuyển plan sang server khác được không?',
        a: 'Tạm thời bạn chưa được phép chuyển plan từ 1 server sang 1 server khác. Plan đã gắn với server nào thì ở lại server đó, nên hãy chọn server cho kỹ trước khi mua nhé!',
    },
    {
        q: 'Lifetime nghĩa là gì?',
        a: 'Bạn trả một lần và plan không bao giờ hết hạn, không cần gia hạn hàng tháng. Plan vẫn gắn với server đã mua.',
    },
    {
        q: 'Plan hết hạn thì sao?',
        a: 'Server sẽ quay về plan Default. Những gì bạn đã tạo vẫn được giữ, không bị xóa. Nhưng nếu số lượng đang vượt giới hạn của Default, bạn chỉ có thể xóa bớt cho tới khi về lại giới hạn, rồi mới tạo thêm được. Gia hạn plan là mọi thứ dùng lại bình thường.',
    },
    {
        q: 'Server mình thêm bot từ trước thì giới hạn cũ có còn không?',
        a: 'Còn nhé! Server đã thêm bot trước ngày 01/11/2026 vẫn được giữ giới hạn cũ của plan Default ở những tính năng có giới hạn cũ cao hơn: Autoresponder 50, Form 10, Sticky Message 6, Custom Role 100, Item 10 và Role ưu tiên mỗi panel ticket 5. Các tính năng còn lại dùng giới hạn mới như bảng ở trên.',
    },
    {
        q: 'Mình mua bằng cách nào?',
        a: `Bạn vào [Dashboard](${links.dashboard}), chọn server cần nâng cấp rồi mua plan ngay trong đó. Gia hạn cũng làm ở Dashboard luôn. Nếu cần hoàn tiền thì xem [Chính sách Hoàn tiền](/docs/policy/refund).`,
    },
    {
        q: 'Mình muốn xóa hẳn thương hiệu & host dưới dạng bot riêng thì sao?',
        a: 'Đó là dịch vụ [Whitelabel](/docs/premium/whitelabel), tách riêng với plan ở trang này.',
    },
];

const inline = (s: string) => s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
const plain = (s: string) => s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1');

const title = `Bảng giá Premium | ${name}`;
const description = `Bảng giá Premium của ${name}: plan Plus từ 36.000đ/tháng, Extended từ 59.000đ/tháng hoặc lifetime, nâng giới hạn Autoresponder, Embed, Ticket, Giveaway cho server Discord của bạn.`;
const keywords = `${name} premium, GlitchBucket premium, GlitchBucket bảng giá, bot discord premium, bot discord việt nam, nâng cấp server discord, autoresponder, ticket bot, giveaway bot`;
const offer = (plan: string, price: number, period: string) => ({
    '@type': 'Offer',
    name: `${plan} (${period})`,
    price,
    priceCurrency: 'VND',
    availability: 'https://schema.org/InStock',
    url: `${BRAND.site}/premium`,
});
const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: `${name} Premium`,
        description,
        image: 'https://cdn.tudubucket.dev/widebucket.png',
        brand: { '@type': 'Brand', name },
        offers: plans.flatMap((p) => (p.month ? [offer(p.name, p.month, '1 tháng'), offer(p.name, p.lifetime!, 'vĩnh viễn')] : [])),
    },
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
    },
];
const arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6"/></svg>';
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
const plus = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
---
<Page title={title} description={description} path="/premium" keywords={keywords} schema={schema} embed={premiumEmbed}>
    <section class="p-hero sheet">
        <div class="hero-emoji" aria-hidden="true"></div>
        <div class="wrap">
            <div class="p-hero-copy">
                <h1><span class="line grad">Quản lí server</span><span class="line">ở một mức độ cao hơn.</span></h1>
                <p class="hero-lead">Đôi khi những cộng đồng cần những giới hạn lớn hơn những giới hạn mà vốn chúng đã lớn sẵn.</p>
                <div class="hero-actions">
                    <a class="btn btn-main" href="#plans">Xem các plan</a>
                    <a class="btn btn-ghost" href={links.support}>Liên hệ</a>
                </div>
            </div>
            <div class="p-plans" id="plans">
                {plans.map((plan, i) => (
                    <article class:list={['sticker p-card', { featured: plan.featured }]} style={`--i:${i}`}>
                        {plan.featured && <span class="p-badge"><img src="/crown.png" alt="" width="14" height="14">Nhiều người chọn</span>}
                        <h2>{plan.name}</h2>
                        <p class="p-tagline">{plan.tagline}</p>
                        <div class="p-price">
                            {plan.month ? (
                                <>
                                    <p class="p-amount"><strong class="num">{money(plan.month)}</strong><span>/tháng</span></p>
                                    <p class="p-alt">hoặc vĩnh viễn với <strong>{money(plan.lifetime!)}</strong></p>
                                </>
                            ) : (
                                <>
                                    <p class="p-amount"><strong class="num">Liên hệ</strong></p>
                                    <p class="p-alt">Giá theo nhu cầu của server</p>
                                </>
                            )}
                        </div>
                        <ul class="p-points">
                            <li class="p-includes">Bao gồm mọi quyền lợi của {plan.includes}, và</li>
                            {plan.points.map((point) => <li><Fragment set:html={check} />{point}</li>)}
                        </ul>
                        <a class:list={['btn', plan.featured ? 'btn-main' : 'btn-ghost']} href={plan.month ? links.dashboard : links.support}>
                            {plan.month ? 'Mua trên Dashboard' : 'Liên hệ ở server hỗ trợ'}<Fragment set:html={arrow} />
                        </a>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="p-benefits paper">
        <div class="wrap">
            <div class="section-head" data-reveal>
                <h2>Bạn nhận được gì?</h2>
                <p>Những điều thay đổi khi server lên plan cao hơn.</p>
            </div>
            <div class="p-benefit-grid">
                {benefits.map((benefit, i) => (
                    <div class="p-benefit" data-reveal style={`--d:${i}`}>
                        <span class="p-icon" aria-hidden="true"><img src={`https://cdn.jsdelivr.net/gh/jdecked/twemoji@15.1.0/assets/svg/${benefit.icon}.svg`} alt="" width="28" height="28" loading="lazy"></span>
                        <h3>{benefit.title}</h3>
                        <p>{benefit.text}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="p-compare sheet" id="compare">
        <div class="wrap">
            <div class="section-head" data-reveal>
                <h2>So sánh chi tiết</h2>
                <p>Số lượng tối đa của từng tính năng trong một server.</p>
            </div>
            <div class="sticker p-table" data-reveal>
                <div class="p-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Tính năng</th>
                                <th scope="col">Default</th>
                                <th scope="col" class="hl">Plus</th>
                                <th scope="col">Extended</th>
                                <th scope="col">Enterprise</th>
                            </tr>
                        </thead>
                        {groups.map((group) => (
                            <tbody>
                                <tr class="group"><th colspan="5" scope="colgroup">{group.title}</th></tr>
                                {group.rows.map((row) => (
                                    <tr>
                                        <th scope="row">{row.label}</th>
                                        <td>{fmt(row.default)}</td>
                                        <td class="hl">{fmt(row.plus)}</td>
                                        <td>{fmt(row.extended)}</td>
                                        <td class="custom">Tùy chỉnh</td>
                                    </tr>
                                ))}
                            </tbody>
                        ))}
                        <tbody>
                            <tr class="group"><th colspan="5" scope="colgroup">Khác</th></tr>
                            {extras.map(([label, base, plusValue, extended]) => (
                                <tr>
                                    <th scope="row">{label}</th>
                                    <td>{base}</td>
                                    <td class="hl">{plusValue}</td>
                                    <td>{extended}</td>
                                    <td class="custom">Tùy chỉnh</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section class="p-faq paper" id="faq">
        <div class="wrap p-faq-grid">
            <div class="section-head" data-reveal>
                <h2>Câu hỏi thường gặp</h2>
                <p>Cần tư vấn thêm? Cứ ghé <a href={links.support}>server hỗ trợ</a> hỏi tụi mình nhé!</p>
            </div>
            <div class="p-faq-list" data-reveal style="--d:1">
                {faqs.map((faq) => (
                    <details>
                        <summary>{faq.q}<Fragment set:html={plus} /></summary>
                        <p set:html={inline(faq.a)} />
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="close sheet">
        <div class="wrap close-grid">
            <div data-reveal>
                <h2>Sẵn sàng nâng cấp server?</h2>
                <p>Server của bạn chỉ còn cách vài bước. Chọn server trên Dashboard và mua plan ngay trong đó.</p>
                <div class="hero-actions">
                    <a class="btn btn-main" href={links.dashboard}>Mở Dashboard<Fragment set:html={arrow} /></a>
                    <a class="btn btn-ghost" href={links.support}>Liên hệ</a>
                </div>
            </div>
        </div>
    </section>
</Page>

---
// Thẻ <script id="discord:component-embed"> (web/data/embed.mjs). JSON trong <script>: thoát < > & để không đóng thẻ sớm,
// escape vẫn tính vào giới hạn 3.000 byte của Discord.
interface Props {
    embed: object;
}
const { embed } = Astro.props;
const escape = (c: string) => String.fromCharCode(92) + 'u' + c.charCodeAt(0).toString(16).padStart(4, '0');
const json = JSON.stringify(embed).replace(/[<>&]/g, escape);
const size = new TextEncoder().encode(json).length;
if (size > 3000) throw new Error(`Component embed ${Astro.url.pathname}: ${size} byte > 3000`);
---
<script is:inline id="discord:component-embed" type="application/json" set:html={json} />
